# reSpotIt local server (solo)
# Copy to .env and fill in values.
# For the full stack, start-full-stack.bat/.sh creates/repairs .env itself:
# it preserves existing secrets and only fills missing/placeholder values.

# Core
# LAN_IP / PUBLIC_ORIGIN are rewritten on every start-full-stack run from the
# PC's current LAN address. Exposed URLs must never use localhost: a phone or
# another PC would resolve that to itself.
LAN_IP=192.168.1.11
PUBLIC_ORIGIN=https://192.168.1.11
REDIRECT_URI=https://192.168.1.11:8000/api/v1/auth/callback
PUBLIC_BASE_URL=https://192.168.1.11:8000
SSL_ENABLED=true
# Browser origins allowed to call the API directly. The web frontend is served
# from the same origin (nginx proxies /api), so only add origins you actually
# use. "*" is accepted but disables the browser-origin check.
CORS_ALLOW_ORIGIN=https://192.168.1.11:8888,http://192.168.1.11:8888,http://127.0.0.1:8888
# Proxies whose X-Forwarded-* headers may be trusted. Keep this to addresses you
# control; "*" lets any client spoof its own IP/protocol/scheme.
FORWARDED_ALLOW_IPS=127.0.0.1,::1

# Spotify credentials. The client id is required. The client secret is
# optional: with one, the server is a confidential client; without one, the
# authorization flow uses PKCE, the same way the phone does.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ────────────────────────────────────────────────────────────────────────────
# Full stack (OpenWebUI + Keycloak + MCP) — only needed when using
# docker-compose.full.yml overlay. That overlay needs certs/ and the
# OpenWebUI-stack/ folder; see docs/DEPLOYMENT.md for how to obtain them.
# ────────────────────────────────────────────────────────────────────────────

# Keycloak / OpenWebUI OIDC
KEYCLOAK_REALM=open-webui
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_ENABLED=true
KEYCLOAK_CLIENT_ID=open-webui
KEYCLOAK_CLIENT_SECRET=open-webui-secret
KEYCLOAK_HOSTNAME=https://192.168.1.11/authKeycloak
# API-side Keycloak login (native apps). Internal = compose network, public = LAN.
KEYCLOAK_INTERNAL_URL=http://keycloak:8080/authKeycloak
KEYCLOAK_PUBLIC_URL=https://192.168.1.11/authKeycloak
KEYCLOAK_ISSUER=https://192.168.1.11/authKeycloak/realms/open-webui
KEYCLOAK_REDIRECT_URI=http://192.168.1.11:8888/api/v1/auth/keycloak/callback
KEYCLOAK_ALLOWED_REDIRECTS=http://192.168.1.11:8888,https://192.168.1.11,http://localhost:8888,http://127.0.0.1:8888,http://localhost:3000,http://127.0.0.1:3000
OPENID_PROVIDER_URL=https://192.168.1.11/authKeycloak/realms/open-webui/.well-known/openid-configuration
OPENID_REDIRECT_URI=https://192.168.1.11/oauth/oidc/callback
OAUTH_PROVIDER_NAME=Keycloak
OAUTH_SCOPES=openid email profile
OAUTH_CLIENT_ID=open-webui
OAUTH_CLIENT_SECRET=open-webui-secret
OAUTH_AUTO_SIGNUP=true
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=true
ENABLE_OAUTH_SIGNUP=true

# OpenWebUI database
OPENWEBUI_DB_USER=openwebui
OPENWEBUI_DB_PASSWORD=change-me
OPENWEBUI_DB_NAME=openwebui
WEBUI_AUTH=true
DEFAULT_USER_ROLE=user
WEBUI_SECRET_KEY=change-me

# MinIO / Redis (full stack: Open WebUI file storage + websocket manager).
# Empty/default values keep the existing local MinIO data readable.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET_NAME=openwebui
MINIO_REGION=us-east-1

# Spotify MCP. MCP_API_KEY is the bearer the server enforces; the API sends
# SPOTIFY_MCP_TOKEN. They must be the same value - generate one with:
#   python -c "import secrets;print(secrets.token_hex(32))"
MCP_API_KEY=
SPOTIFY_MCP_URL=http://spotify-mcp:8000/mcp
SPOTIFY_MCP_TOKEN=
# PKCE callback for scripts/spotify-mcp-auth.ps1, which runs the flow on the
# host: the listener must be reachable by your browser on loopback. Must match a
# redirect URI registered in the Spotify app exactly. 8888 is the package
# default but is held by the Windows IP Helper service on some machines.
SPOTIFY_MCP_REDIRECT_URI=http://127.0.0.1:8899/callback
# MCP tool surface. "all" exposes every tool on both servers (currently
# 169 = 131 spotify + 38 reSpotIt). That is ~42k prompt tokens if the
# schemas are sent verbatim, which alone overflows a 16k context — so the
# assistant does not send them verbatim: it advertises a small tool-search
# surface and reveals schemas on demand (docs/AI-TOOL-ROUTING-PLAN.md).
# A comma-separated allowlist still works and narrows the searchable set.
MCP_TOOLS=all
RESPOTIT_MCP_TOOLS=all

# reSpotIt MCP service account
RESPOTIT_MCP_EMAIL=mcp-service@respotit.local
RESPOTIT_MCP_PASSWORD=change-me
RESPOTIT_MCP_USER_ID=
RESPOTIT_MCP_API_URL=https://api:8000
RESPOTIT_MCP_API_VERIFY_TLS=false
RESPOTIT_MCP_TOKEN=change-me
RESPOTIT_MCP_URL=http://respotit-mcp:8000/mcp
# Assistant Spotify grant. The API writes the Spotify MCP's token file from the
# Spotify account the assistant follows, so the tools need no OAuth consent of
# their own: seeding runs at API startup and after every Spotify link/relink.
# SPOTIFY_MCP_GRANT_USER pins which user that is (unset: the user recorded in the
# token file, else the earliest linked user). SPOTIFY_MCP_DATA_DIR must match the
# bind mount the api service gets. SPOTIFY_MCP_GRANT_SEED=0 stops seeding.
SPOTIFY_MCP_GRANT_USER=
SPOTIFY_MCP_DATA_DIR=/data/spotify-mcp
SPOTIFY_MCP_GRANT_SEED=1

# OpenWebUI integration
# Trusted-header sign-in is used only by the API against the internal
# open-webui-2 instance. The public instance at PUBLIC_ORIGIN uses OIDC.
OPENWEBUI_TRUSTED_AUTH=true
OPENWEBUI_URL=http://open-webui-2:8080
OPENWEBUI_TRUSTED_HEADER=X-OWUI-Trusted-Email
OPENWEBUI_TRUSTED_NAME_HEADER=X-OWUI-Trusted-Name

# Optional external model endpoint (leave blank for no model)
OPENAI_API_BASE_URL=
OPENAI_API_KEY=

# Open WebUI API key (auto-generated on first deploy if trusted auth is enabled;
# persisted to /data/.owui_api_key). Set manually to override.

# AI assistant tool routing and context budget.
# auto = advertise ten hot tools plus tool_search/tool_describe/tool_call and
# reveal the other 150+ MCP tools on demand (~3k prompt tokens instead of ~42k).
# all  = send every MCP schema on every turn; only sane with a large context.
# off  = no tools.
LLM_TOOL_ROUTER=auto
# Must match llama-server -c. The guard refuses a request above
# LLM_CONTEXT_BUDGET of this instead of letting the model reject it.
LLM_CONTEXT_TOKENS=16384
LLM_CONTEXT_BUDGET=0.8
# L3 hybrid: after tool_search, inject this many real schemas so the model can
# call them natively (0 disables, max 8).
LLM_TOOL_REVEAL=5
# L1 pre-reveal: advertise the router's best non-hot tools up front, from the
# user's own words, so a small model does not reach for a plausible hot tool
# instead of searching. 0 disables; the token budget caps the extra prompt cost
# (a schema that does not fit is skipped, never truncated).
LLM_TOOL_PREREVEAL=2
LLM_TOOL_PREREVEAL_TOKENS=800
# Key the pipelines server and Open WebUI share. With a key set, compose adds
# the pipelines server as a second OpenAI connection so the inlet guard in
# pipelines/respotit_context_guard.py runs for every model. Leave
# empty and the guard stays disconnected (chats still work).
PIPELINES_API_KEY=

# Telemetry
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false